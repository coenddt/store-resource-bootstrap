{
  "comment": "双端一致性用例：同一份 JSON，node:test 与 pytest 各自加载执行。双端命名差异以 {node, py} 表达；本文件不复制实现常量（三 schema 除外——其为内置可选参考定义的镜像）。",
  "facades": {
    "node": ["has", "register", "configureResource", "resourceOpen", "resourcePut", "registerProvider"],
    "py": ["has", "register", "configure_resource", "resource_open", "resource_put", "register_provider"]
  },
  "expect_error_class": { "node": "Error", "py": "ValueError" },
  "schemas": {
    "names": ["Resource", "ResourceLocation", "ResourceBinding"],
    "collections": {
      "Resource": "resources",
      "ResourceLocation": "resource_locations",
      "ResourceBinding": "resource_bindings"
    },
    "id_prefixes": { "Resource": "", "ResourceLocation": "rl", "ResourceBinding": "rb" },
    "canonical": [
      {
        "name": "Resource", "collection": "resources", "idPrefix": "", "timestamps": true,
        "read": [], "write": [],
        "fields": {
          "_id":      { "type": "string" },
          "sha1":     { "type": "string" },
          "fileName": { "type": "string" },
          "mime":     { "type": "string" },
          "size":     { "type": "int" },
          "kind":     { "type": "string" }
        },
        "relations": {},
        "indexes": [ { "keys": { "sha1": 1 }, "options": { "unique": true } } ]
      },
      {
        "name": "ResourceLocation", "collection": "resource_locations", "idPrefix": "rl", "timestamps": true,
        "read": [], "write": [],
        "fields": {
          "_id":        { "type": "string" },
          "resourceId": { "type": "string" },
          "backend":    { "type": "string" },
          "key":        { "type": "string" },
          "status":     { "type": "string" },
          "priority":   { "type": "int" }
        },
        "relations": {
          "resource": { "model": "Resource", "type": "one", "localField": "resourceId", "foreignField": "_id", "read": [] }
        },
        "indexes": [ { "keys": { "resourceId": 1, "backend": 1 }, "options": { "unique": true } } ]
      },
      {
        "name": "ResourceBinding", "collection": "resource_bindings", "idPrefix": "rb", "timestamps": true,
        "read": [], "write": [],
        "fields": {
          "_id":           { "type": "string" },
          "resourceId":    { "type": "string" },
          "businessTable": { "type": "string" },
          "businessId":    { "type": "string" },
          "userId":        { "type": "string" }
        },
        "relations": {
          "resource": { "model": "Resource", "type": "one", "localField": "resourceId", "foreignField": "_id", "read": [] }
        },
        "indexes": [ { "keys": { "resourceId": 1, "businessTable": 1, "businessId": 1 }, "options": { "unique": true } } ]
      }
    ]
  },
  "capability": {
    "fresh": {
      "opts": {
        "providers": [ { "kind": "local", "options": { "root": "/data/resources" }, "priority": 0 } ],
        "url": { "base": "https://cdn.example.com" },
        "sign": null
      },
      "schemas_ref": "canonical",
      "seed": [],
      "expected_calls": [
        ["register", "Resource"],
        ["register", "ResourceLocation"],
        ["register", "ResourceBinding"],
        ["configureResource", {
          "providers": [ { "kind": "local", "options": { "root": "/data/resources" }, "priority": 0 } ],
          "url": { "base": "https://cdn.example.com" },
          "sign": null,
          "schema": { "resource": "Resource", "location": "ResourceLocation", "binding": "ResourceBinding" }
        }]
      ],
      "expected_return": { "registered": ["Resource", "ResourceLocation", "ResourceBinding"], "skipped": [], "providerRegistered": [] }
    },
    "idempotent": {
      "opts": { "providers": [ { "kind": "local" } ] },
      "schemas_ref": "canonical",
      "seed": ["Resource", "ResourceLocation", "ResourceBinding"],
      "expected_calls": [
        ["configureResource", {
          "providers": [ { "kind": "local" } ],
          "url": {},
          "sign": null,
          "schema": { "resource": "Resource", "location": "ResourceLocation", "binding": "ResourceBinding" }
        }]
      ],
      "expected_return": { "registered": [], "skipped": ["Resource", "ResourceLocation", "ResourceBinding"], "providerRegistered": [] }
    },
    "defaults": {
      "opts": { "providers": [ { "kind": "local" } ] },
      "seed": [],
      "expected_calls": [
        ["configureResource", {
          "providers": [ { "kind": "local" } ],
          "url": {},
          "sign": null,
          "schema": { "resource": "Resource", "location": "ResourceLocation", "binding": "ResourceBinding" }
        }]
      ],
      "expected_return": { "registered": [], "skipped": [], "providerRegistered": [] }
    },
    "schemas_disabled": {
      "opts": { "providers": [ { "kind": "local" } ], "schemas": null },
      "seed": [],
      "expected_calls": [
        ["configureResource", {
          "providers": [ { "kind": "local" } ],
          "url": {},
          "sign": null,
          "schema": { "resource": "Resource", "location": "ResourceLocation", "binding": "ResourceBinding" }
        }]
      ],
      "expected_return": { "registered": [], "skipped": [], "providerRegistered": [] }
    },
    "custom_schemas": {
      "opts": {
        "providers": [ { "kind": "local" } ],
        "schemas": [
          {
            "name": "BizAsset", "collection": "biz_assets", "idPrefix": "ba", "timestamps": true,
            "read": [], "write": [],
            "fields": { "_id": { "type": "string" }, "resourceId": { "type": "string" } },
            "relations": {},
            "indexes": [ { "keys": { "resourceId": 1 }, "options": {} } ]
          }
        ]
      },
      "seed": [],
      "expected_calls": [
        ["register", "BizAsset"],
        ["configureResource", {
          "providers": [ { "kind": "local" } ],
          "url": {},
          "sign": null,
          "schema": { "resource": "Resource", "location": "ResourceLocation", "binding": "ResourceBinding" }
        }]
      ],
      "expected_return": { "registered": ["BizAsset"], "skipped": [], "providerRegistered": [] }
    },
    "fields_passthrough": {
      "opts": {
        "providers": [ { "kind": "local" } ],
        "fields": {
          "resource": { "sha1": "contentHash", "fileName": "name", "mime": "contentType", "size": null, "kind": null },
          "location": { "backend": "store", "key": "objectKey", "status": null },
          "binding": { "businessTable": "entity", "userId": null }
        }
      },
      "seed": [],
      "expected_calls": [
        ["configureResource", {
          "providers": [ { "kind": "local" } ],
          "url": {},
          "sign": null,
          "schema": { "resource": "Resource", "location": "ResourceLocation", "binding": "ResourceBinding" },
          "fields": {
            "resource": { "sha1": "contentHash", "fileName": "name", "mime": "contentType", "size": null, "kind": null },
            "location": { "backend": "store", "key": "objectKey", "status": null },
            "binding": { "businessTable": "entity", "userId": null }
          }
        }]
      ],
      "expected_return": { "registered": [], "skipped": [], "providerRegistered": [] }
    },
    "provider_plugins": {
      "opts": {
        "providers": [ { "kind": "local" } ],
        "providerPlugins": [ { "kind": "oss" }, { "kind": "minio" } ]
      },
      "schemas_ref": "canonical",
      "seed": [],
      "expected_registered_kinds": ["oss", "minio"],
      "expected_return_rest": {
        "registered": ["Resource", "ResourceLocation", "ResourceBinding"],
        "skipped": []
      },
      "expected_tail_calls": [
        ["configureResource", {
          "providers": [ { "kind": "local" } ],
          "url": {},
          "sign": null,
          "schema": { "resource": "Resource", "location": "ResourceLocation", "binding": "ResourceBinding" }
        }]
      ]
    },
    "invalid": [
      { "name": "unknown_key",            "opts": { "providers": [ { "kind": "local" } ], "foo": 1 },           "error_contains": "foo",      "expected_call_count": 0 },
      { "name": "providers_missing",      "opts": {},                                                            "error_contains": "providers", "expected_call_count": 0 },
      { "name": "providers_empty",        "opts": { "providers": [] },                                            "error_contains": "providers", "expected_call_count": 0 },
      { "name": "bad_kind",               "opts": { "providers": [ { "kind": "" } ] },                             "error_contains": "kind",      "expected_call_count": 0 },
      { "name": "bad_options",            "opts": { "providers": [ { "kind": "local", "options": 1 } ] },          "error_contains": "options",   "expected_call_count": 0 },
      { "name": "bad_priority",           "opts": { "providers": [ { "kind": "local", "priority": 1.5 } ] },       "error_contains": "priority",  "expected_call_count": 0 },
      { "name": "bad_url",                "opts": { "providers": [ { "kind": "local" } ], "url": 1 },              "error_contains": "url",       "expected_call_count": 0 },
      { "name": "bad_sign",               "opts": { "providers": [ { "kind": "local" } ], "sign": "x" },           "error_contains": "sign",      "expected_call_count": 0 },
      { "name": "bad_schema",             "opts": { "providers": [ { "kind": "local" } ], "schema": 1 },           "error_contains": "schema",    "expected_call_count": 0 },
      { "name": "provider_plugins_not_array", "opts": { "providers": [ { "kind": "local" } ], "providerPlugins": 1 },                          "error_contains": "providerPlugins", "expected_call_count": 0 },
      { "name": "provider_plugins_bad_item",  "opts": { "providers": [ { "kind": "local" } ], "providerPlugins": [ 1 ] },                        "error_contains": "providerPlugins", "expected_call_count": 0 },
      { "name": "provider_plugins_bad_kind",  "opts": { "providers": [ { "kind": "local" } ], "providerPlugins": [ { "kind": "" } ] },           "error_contains": "kind",            "expected_call_count": 0 },
      { "name": "provider_plugins_bad_create","opts": { "providers": [ { "kind": "local" } ], "providerPlugins": [ { "kind": "oss", "create": "x" } ] }, "error_contains": "create",  "expected_call_count": 0 },
      { "name": "schemas_not_array",       "opts": { "providers": [ { "kind": "local" } ], "schemas": 1 },          "error_contains": "schemas", "expected_call_count": 0 },
      { "name": "schemas_bad_item",        "opts": { "providers": [ { "kind": "local" } ], "schemas": [ 1 ] },       "error_contains": "schemas", "expected_call_count": 0 },
      { "name": "schemas_bad_name",        "opts": { "providers": [ { "kind": "local" } ], "schemas": [ { "collection": "x" } ] }, "error_contains": "schemas", "expected_call_count": 0 },
      { "name": "fields_not_object",       "opts": { "providers": [ { "kind": "local" } ], "fields": 1 },                                          "error_contains": "fields",   "expected_call_count": 0 },
      { "name": "fields_unknown_table",    "opts": { "providers": [ { "kind": "local" } ], "fields": { "bogus": {} } },                            "error_contains": "fields",   "expected_call_count": 0 },
      { "name": "fields_table_not_object", "opts": { "providers": [ { "kind": "local" } ], "fields": { "resource": 1 } },                           "error_contains": "fields",   "expected_call_count": 0 },
      { "name": "fields_unknown_role",     "opts": { "providers": [ { "kind": "local" } ], "fields": { "resource": { "bogus": "x" } } },            "error_contains": "fields",   "expected_call_count": 0 },
      { "name": "fields_required_null",    "opts": { "providers": [ { "kind": "local" } ], "fields": { "resource": { "sha1": null } } },            "error_contains": "sha1",     "expected_call_count": 0 },
      { "name": "fields_required_empty",   "opts": { "providers": [ { "kind": "local" } ], "fields": { "location": { "backend": "" } } },           "error_contains": "backend",  "expected_call_count": 0 },
      { "name": "fields_optional_bad",     "opts": { "providers": [ { "kind": "local" } ], "fields": { "binding": { "userId": 1 } } },              "error_contains": "userId",   "expected_call_count": 0 }
    ]
  },
  "adapter": {
    "download": {
      "opts": {},
      "record": { "file": "ref1" },
      "expected_result": { "contentType": "text/plain", "fileName": "a.txt", "body_text": "hello" },
      "expected_open_call": ["resourceOpen", "ref1", {}]
    },
    "download_field": {
      "opts": { "field": "coverId" },
      "record": { "coverId": "ref2" },
      "expected_open_call": ["resourceOpen", "ref2", {}]
    },
    "download_order": {
      "opts": { "order": ["local"] },
      "record": { "file": "ref1" },
      "expected_open_call": ["resourceOpen", "ref1", { "order": ["local"] }]
    },
    "missing_ref": [
      { "name": "absent",      "record": {},                "error_contains": "file" },
      { "name": "empty",       "record": { "file": "" },    "error_contains": "file" },
      { "name": "null_record", "record": null,              "error_contains": "file" }
    ],
    "mime_fallback": {
      "open": { "mime": null, "fileName": "a.txt" },
      "expected": { "contentType": "application/octet-stream", "fileName": "a.txt" }
    },
    "filename_fallback": {
      "open": { "mime": "text/plain", "fileName": null },
      "expected": { "contentType": "text/plain", "fileName": "ref1" }
    },
    "upload": {
      "input": { "bytes": [104, 105], "file_name": "a.txt", "mime": "text/plain", "kind": "file", "bind": null }
    },
    "download_dot_path": {
      "opts": { "field": "images.original" },
      "record": { "images": { "original": "ref3" } },
      "expected_open_call": ["resourceOpen", "ref3", {}]
    },
    "download_request_field": {
      "opts": { "field": "file" },
      "record": { "file": "ref0", "images": { "original": "ref1" } },
      "request_query": { "field": "images.original" },
      "expected_open_call": ["resourceOpen", "ref1", {}]
    },
    "upload_resolver": {
      "opts": { "kind": "image" },
      "record": { "_id": "ART1", "fileName": "rec.jpg" },
      "request": {
        "body_bytes": [104, 105],
        "query": { "fileName": "a.png", "mime": "image/png" },
        "headers": { "content-type": "image/png" }
      },
      "expected_put": {
        "node": { "bytes": [104, 105], "kind": "image", "fileName": "a.png", "mime": "image/png" },
        "py":   { "bytes": [104, 105], "kind": "image", "file_name": "a.png", "mime": "image/png" }
      },
      "expected_ref": "sha1"
    }
  },
  "machine_checks": {
    "forbidden_literals": ["404", "NOT_FOUND", "ERR_", "500"],
    "forbidden_host_refs": ["require('nodejs-store')", "require(\"nodejs-store\")", "import py_store", "from py_store"],
    "forbidden_calls": ["createHash", "hashlib", "resourceComposeUrl", "resource_compose_url"]
  }
}
